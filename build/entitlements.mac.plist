<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript at runtime, which the hardened runtime blocks
         without these. Every Electron app needs them. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- The agent spawns MCP servers and, optionally, the Claude Code or
         Codex CLI as child processes. -->
    <key>com.apple.security.inherit</key>
    <true/>

    <!-- Browsing, plus the loopback control plane external agents connect to. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Downloads, and reading files the user picks for config import. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
